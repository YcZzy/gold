<template name="reminder-settings">
    <view class="settings-card types-card">
      <view class="section-heading"><view class="section-title">设置提醒条件</view><text class="section-caption">按需设置</text></view>
      <view class="type-grid">
        <button wx:for="{{types}}" wx:key="value" class="type-button {{draft.type === item.value && editing ? 'selected' : ''}} ui-btn ui-choice {{draft.type === item.value && editing ? 'ui-selected' : ''}}" data-type="{{item.value}}" bindtap="editRule" disabled="{{busy}}" aria-pressed="{{draft.type === item.value && editing}}" hover-class="ui-pressed">
          <view class="type-label">{{item.label}}</view>
          <view class="type-description">{{item.value === 'priceAbove' ? '价格达到设定上限' : item.value === 'priceBelow' ? '价格达到设定下限' : item.value === 'dailyMove' ? '较上一收盘价的变化' : item.value === 'rapidMove' ? '约 15 分钟内的变化' : item.value === 'scheduled' ? '按设定时间通知' : '查看当日收盘'}}</view>
        </button>
      </view>
      <view class="helper">每个项目每类可设置一条提醒，点击已有类型可修改。股票与 ETF 按常规交易时段监测。</view>
    </view>

    <view wx:if="{{editing}}" id="reminder-editor" class="settings-card editor">
      <view class="section-heading"><view class="section-title">{{editLabel}}</view><text class="editor-badge">{{draft.id ? '编辑提醒' : '新建提醒'}}</text></view>
      <view wx:if="{{draft.type === 'priceAbove' || draft.type === 'priceBelow'}}" class="price-editor">
        <view class="field-label">目标价格</view>
        <view class="input-row"><input type="digit" value="{{draft.value}}" bindinput="onValue" disabled="{{busy}}" placeholder="输入目标价格" aria-label="目标价格，{{asset.unit}}" maxlength="12" placeholder-style="color: var(--text-mid);" /><text class="input-unit">{{asset.unit}}</text></view>
        <view class="helper">{{draft.type === 'priceAbove' ? '价格达到或高于目标价时提醒' : '价格达到或低于目标价时提醒'}}，触发后自动关闭。</view>
      </view>
      <view wx:elif="{{draft.type === 'dailyMove' || draft.type === 'rapidMove'}}" class="percent-editor">
        <view class="field-label">{{draft.type === 'rapidMove' ? '15 分钟内' : '较昨收'}}涨跌达到以下幅度时提醒</view>
        <view class="percent-options"><button wx:for="{{pctOptions}}" wx:key="*this" class="ui-btn ui-choice {{pctIndex === index ? 'ui-selected' : ''}}" data-index="{{index}}" bindtap="choosePercent" disabled="{{busy}}" aria-pressed="{{pctIndex === index}}" hover-class="ui-pressed">{{item}}%</button></view>
        <view wx:if="{{draft.type === 'rapidMove'}}" class="helper">需约 15 分钟积累有效报价后开始判断。</view>
      </view>
      <view wx:elif="{{draft.type === 'scheduled'}}">
        <picker mode="time" value="{{draft.time}}" bindchange="onTime" disabled="{{busy}}" aria-label="选择播报时间">
          <view class="picker-field"><view class="field-label">播报时间 · 北京时间</view><view class="picker-content"><text class="picker-value">{{draft.time}}</text><view class="picker-chevron" aria-hidden="true"></view></view></view>
        </picker>
        <view class="setting-row"><view class="setting-copy"><view>仅周一至周五</view><view class="setting-description">按星期安排，不代表交易日历</view></view><switch checked="{{draft.weekdaysOnly}}" disabled="{{busy}}" bindchange="onWeekdays" color="{{theme === 'blackgold' ? '#d9b45b' : '#2c2c2a'}}" aria-label="仅周一至周五播报" /></view>
      </view>
      <view wx:elif="{{draft.type === 'close'}}" class="close-description">根据当日有效收盘报价播报，行情缺失时等待有效报价。</view>
      <view class="setting-row enabled-setting"><view class="setting-copy"><view>保存后启用</view><view class="setting-description">{{draft.enabled ? '保存后按设定条件监测' : '保存条件，暂不触发推送'}}</view></view><switch checked="{{draft.enabled}}" disabled="{{busy}}" bindchange="onEnabled" color="{{theme === 'blackgold' ? '#d9b45b' : '#2c2c2a'}}" aria-label="保存后启用" /></view>
      <view wx:if="{{errorText}}" class="error-bar" role="alert">{{errorText}}</view>
      <view class="helper">保存条件后，还需对应授权次数大于 0，满足条件才能发送通知。</view>
      <view class="editor-actions"><button class="primary ui-btn ui-primary" bindtap="saveRule" loading="{{busy}}" disabled="{{busy}}" hover-class="ui-pressed">{{busy ? '正在保存' : '保存提醒'}}</button><button class="cancel-button ui-btn ui-secondary" bindtap="cancelEdit" disabled="{{busy}}" hover-class="ui-pressed">取消编辑</button></view>
    </view>

    <view class="section-heading rules-heading"><view class="section-title">已设置提醒</view><text class="section-caption">{{rules.length}} 条规则</text></view>
    <view class="settings-card rules-card">
      <view wx:if="{{!rules.length}}" class="empty-rules"><view class="empty-title">还没有提醒规则</view><view class="muted">选择上方类型，设置你的第一条提醒。</view></view>
      <view wx:for="{{rules}}" wx:key="id" class="rule-row">
        <button class="rule-copy ui-row" data-type="{{item.type}}" bindtap="editRule" disabled="{{busy}}" aria-label="编辑{{item.summary}}" hover-class="ui-pressed"><view class="rule-summary"><text>{{item.summary}}</text><view class="chevron" aria-hidden="true"></view></view><text class="rule-status">{{item.enabled ? '检测中' : '已暂停'}}</text></button>
        <view class="rule-actions"><view class="rule-toggle"><switch checked="{{item.enabled}}" disabled="{{busy}}" data-id="{{item.id}}" bindchange="toggleRule" color="{{theme === 'blackgold' ? '#d9b45b' : '#2c2c2a'}}" aria-label="切换{{item.summary}}" /></view><button class="rule-delete ui-btn ui-danger" data-id="{{item.id}}" bindtap="deleteRule" disabled="{{busy}}" aria-label="删除{{item.summary}}提醒" hover-class="ui-pressed">删除</button></view>
      </view>
    </view>
  <view wx:if="{{statusNote}}" class="status-note" role="status">{{statusNote}}</view>
  <view class="settings-card quiet-hours">
    <view class="section-title">免打扰 · 全部提醒共用</view>
    <view class="quiet-pickers">
      <picker mode="time" value="{{prefs.dndStart}}" data-key="dndStart" bindchange="saveDnd" disabled="{{dndBusy}}" aria-label="免打扰开始时间"><view class="quiet-time">{{prefs.dndStart}}</view></picker>
      <text>至</text>
      <picker mode="time" value="{{prefs.dndEnd}}" data-key="dndEnd" bindchange="saveDnd" disabled="{{dndBusy}}" aria-label="免打扰结束时间"><view class="quiet-time">{{prefs.dndEnd}}</view></picker>
    </view>
    <view class="helper">北京时间，选择后自动保存。时效内顺延发送，过期提醒不补发。</view>
    <view wx:if="{{dndError}}" class="error-bar" role="alert">{{dndError}}</view>
    <view wx:elif="{{dndBusy || dndNote}}" class="helper" role="status">{{dndBusy ? '正在保存…' : dndNote}}</view>
  </view>
</template>
