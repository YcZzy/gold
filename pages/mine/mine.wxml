<page-meta page-style="background-color: {{theme === 'blackgold' ? '#14120b' : '#f4f1ea'}};" background-color="{{theme === 'blackgold' ? '#14120b' : '#f4f1ea'}}" root-background-color="{{theme === 'blackgold' ? '#14120b' : '#f4f1ea'}}" />
<view class="page mine-page tab-page theme-{{theme}}">
  <view class="mine-header">
    <view class="mine-heading">
      <view class="hero-title">我的</view>
      <view class="hero-sub">管理个人偏好、账户与看盘工具</view>
    </view>
    <button class="theme-toggle ui-icon ui-icon-label" bindtap="onThemeTap" hover-class="ui-pressed" aria-label="{{theme === 'paper' ? '切换深色主题' : '切换浅色主题'}}">
      <image class="theme-toggle-icon" src="{{theme === 'paper' ? '/assets/icons/moon.svg' : '/assets/icons/sun.svg'}}" mode="aspectFit" aria-hidden="true" />
      <text>{{theme === 'paper' ? '深色' : '浅色'}}</text>
    </button>
  </view>

  <view wx:if="{{errorText}}" class="error-bar" role="alert">{{errorText}}</view>

  <view wx:if="{{hasPortfolio}}" class="mine-card benefits-card {{limits.tier === 'vip' ? 'benefits-vip' : 'benefits-free'}}">
    <view wx:if="{{limits.tier === 'vip'}}" class="member-engraving" aria-hidden="true"></view>
    <view class="benefits-content">
      <view class="section-heading">
        <view>
          <view wx:if="{{limits.tier === 'vip'}}" class="member-eyebrow">GOLD MEMBER</view>
          <view class="section-title">{{limits.tier === 'vip' ? '黄金会员' : '账户权益'}}</view>
        </view>
        <text class="tier-badge">{{limits.tier === 'vip' ? '会员生效中' : '免费版'}}</text>
      </view>
      <view class="benefits-grid">
        <view><view class="benefit-value">{{limits.watchlist}}<text class="metric-unit">个</text></view><view class="metric-label">自选标的上限</view></view>
        <view><view class="benefit-value">{{limits.activeRules}}<text class="metric-unit">条</text></view><view class="metric-label">启用提醒上限</view></view>
      </view>
      <view wx:if="{{membershipExpiry}}" class="member-validity">
        <text class="validity-label">会员有效期至</text>
        <text>{{membershipExpiry}}</text>
      </view>
      <view class="membership-checkout">
        <view class="membership-terms">{{limits.tier === 'vip' ? '手动续费 · 提前续费顺延' : '升级解锁 30 个自选名额 · 手动续费'}}</view>
        <button wx:if="{{!membershipPending}}" class="ui-btn ui-primary membership-action" bindtap="buyMembership" loading="{{membershipBusy}}" disabled="{{membershipBusy}}" hover-class="ui-pressed">
          {{limits.tier === 'vip' ? '¥9.90 续费 30 天' : '¥9.90 开通 30 天'}}
        </button>
        <button wx:if="{{membershipPending}}" class="ui-btn ui-secondary membership-action" bindtap="confirmMembership" loading="{{membershipBusy}}" disabled="{{membershipBusy}}">{{membershipBusy ? '正在确认订单' : '查询订单'}}</button>
        <view wx:if="{{membershipMessage}}" class="membership-feedback" role="status">{{membershipMessage}}</view>
      </view>
    </view>
  </view>

  <view class="mine-card reminder-entry-card">
    <button class="service-action ui-row" bindtap="openAuth" hover-class="ui-pressed" aria-label="前往提醒页设置通知与提醒">
      <view class="action-copy"><view class="action-title">通知与提醒设置</view><view class="action-description">授权次数、提醒条件和免打扰，统一在「提醒」页管理</view></view>
      <view class="chevron" aria-hidden="true"></view>
    </button>
  </view>

  <view class="section-label">看盘工具</view>
  <view class="mine-card">
    <button class="service-action ui-row" data-target="market" bindtap="openWorkspace" hover-class="ui-pressed"><view class="action-copy"><view class="action-title">行情发现</view><view class="action-description">指数、板块、成分股与市场榜单</view></view><view class="chevron" aria-hidden="true"></view></button>
    <button class="service-action ui-row" data-target="holdings" bindtap="openWorkspace" hover-class="ui-pressed"><view class="action-copy"><view class="action-title">我的持仓</view><view class="action-description">手工交易、现金和分币种盈亏</view></view><view class="chevron" aria-hidden="true"></view></button>
    <button class="service-action ui-row" data-target="data" bindtap="openWorkspace" hover-class="ui-pressed"><view class="action-copy"><view class="action-title">分组与备份</view><view class="action-description">分组排序、导入与导出</view></view><view class="chevron" aria-hidden="true"></view></button>
  </view>
  <view class="section-label">通知与服务</view>
  <view class="mine-card diagnostic-card">
    <view class="section-title">自助检测</view>
    <view class="muted">收不到提醒？先检查通知条件。</view>
    <button class="service-action ui-row" bindtap="checkNotifications" loading="{{checkBusy}}" disabled="{{checkBusy}}" hover-class="ui-pressed">
      <view class="action-copy"><view class="action-title">{{checkBusy ? '正在检查' : '检查通知条件'}}</view><view class="action-description">查看规则、授权与最近发送状态</view></view>
      <view class="chevron" aria-hidden="true"></view>
    </button>
    <view wx:if="{{check}}" class="diagnostic" role="status">
      <view wx:if="{{check.error}}" class="muted">{{check.error}}</view>
      <block wx:else>
        <view class="summary-row"><text class="metric-label">提醒规则</text><text>{{check.rules}}</text></view>
        <view class="summary-row"><text class="metric-label">剩余授权</text><text>{{check.quota}}</text></view>
        <view class="summary-row"><text class="metric-label">免打扰</text><text>{{check.dnd}}</text></view>
        <view class="helper">规则需达到设定条件；行情延迟、休市或每日上限也可能影响提醒。免打扰内过期的提醒不补发。</view>
        <view class="record-title">最近发送记录</view>
        <view wx:if="{{!check.recent.length}}" class="muted">暂无记录；请检查规则条件和后台定时任务。</view>
        <view wx:for="{{check.recent}}" wx:key="taskId" class="diagnostic-task">
          <view class="section-heading"><text>{{item.assetName}}</text><text class="task-status">{{item.statusText}}</text></view>
          <view wx:if="{{item.reasonText}}" class="muted">{{item.reasonText}}</view>
          <view class="helper">{{item.timeText}}</view>
        </view>
      </block>
    </view>
    <button class="service-action test-action ui-row" bindtap="testNotification" loading="{{testBusy}}" disabled="{{testBusy}}" hover-class="ui-pressed">
      <view class="action-copy"><view class="action-title">{{testBusy ? '正在发送' : '测试通知'}}</view><view class="action-description">发送一条消息，确认微信能否接收</view></view>
      <view class="chevron" aria-hidden="true"></view>
    </button>
    <view class="helper">消耗 1 次异动授权；测试不受规则条件和免打扰限制。</view>
    <view wx:if="{{testResult}}" class="test-result" role="status">{{testResult}}</view>
  </view>

  <view class="mine-card faq-card">
    <view class="section-title">常见问题</view>
    <view class="question">为什么每次只能增加 1 次？</view>
    <view class="muted">微信订阅消息按模板逐次授权。每次同意一个模板，增加该模板 1 次发送机会；发送成功后消耗 1 次。播报与异动分别计数，请前往「提醒」页增加授权。</view>
  </view>
  <view class="page-footer">后台约每 1 分钟监测。股票与 ETF 按各自市场的常规交易时段、交易日期及已核验日历处理；定时播报按北京时间，「仅周一至周五」仅表示星期。美股自动处理夏令时。</view>
  <view class="page-footer disclaimer">公开行情仅供参考，不构成投资建议。</view>
</view>
