/* 本页独立排版，共用 app.wxss 的纸感 / 黑金主题变量。 */
.reminders-page {
  padding: 40rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}
.reminders-page .reminders-header { margin: 0 4rpx 36rpx; }
.reminders-page .hero-title { font-size: 48rpx; font-weight: 600; line-height: 1.3; letter-spacing: 2rpx; }
.reminders-page .hero-sub { margin-top: 12rpx; color: var(--text-mid); font-size: 24rpx; line-height: 1.65; }
.reminders-page button { box-sizing: border-box; margin: 0; line-height: 1.5; white-space: normal; }
.reminders-page button::after { border: none; }
.reminders-page button[disabled] { opacity: 0.5; }
.reminders-page .control-pressed { opacity: 0.7; }
.reminders-page .reminder-card { padding: 30rpx; background: var(--card); border: 1rpx solid var(--card-border); border-radius: 28rpx; }
.reminders-page .overview-card { border-top: 4rpx solid var(--accent); }
.reminders-page .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.reminders-page .overview-copy { flex: 1; min-width: 0; }
.reminders-page .metric-label { color: var(--text-mid); font-size: 23rpx; line-height: 1.6; }
.reminders-page .active-value { margin-top: 8rpx; font-size: 64rpx; font-weight: 600; line-height: 1.2; font-variant-numeric: tabular-nums; }
.reminders-page .value-limit { margin-left: 14rpx; color: var(--text-mid); font-size: 24rpx; font-weight: 400; }
.reminders-page .pending-value { margin-top: 12rpx; font-size: 30rpx; line-height: 1.5; }
.reminders-page .auth-button { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: auto; }
.reminders-page .quota-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24rpx; margin-top: 30rpx; padding: 26rpx 0 0; border-top: 1rpx solid var(--card-border); }
.reminders-page .quota-item { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6rpx 16rpx; }
.reminders-page .quota-value { font-size: 32rpx; font-weight: 600; line-height: 1.4; font-variant-numeric: tabular-nums; }
.reminders-page .value-unit { margin-left: 6rpx; color: var(--text-mid); font-size: 22rpx; font-weight: 400; }
.reminders-page .helper { margin-top: 20rpx; color: var(--text-mid); font-size: 22rpx; line-height: 1.75; }
.reminders-page .list-heading { margin: 36rpx 6rpx 18rpx; }
.reminders-page .section-title { font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.reminders-page .section-caption { color: var(--text-mid); font-size: 22rpx; line-height: 1.5; }
.reminders-page .asset-card { display: block; width: 100%; margin-top: 18rpx; text-align: left; color: var(--text); font-size: 26rpx; font-weight: 400; }
.reminders-page .asset-heading { padding-bottom: 24rpx; }
.reminders-page .asset-identity { flex: 1; min-width: 0; }
.reminders-page .asset-title { font-size: 30rpx; font-weight: 600; line-height: 1.5; overflow-wrap: break-word; }
.reminders-page .asset-code { margin-top: 6rpx; color: var(--text-mid); font-size: 22rpx; line-height: 1.6; font-variant-numeric: tabular-nums; }
.reminders-page .manage-link { display: flex; align-items: center; flex-shrink: 0; gap: 12rpx; color: var(--text-mid); font-size: 23rpx; }
.reminders-page .chevron { width: 12rpx; height: 12rpx; margin-right: 4rpx; border-right: 2rpx solid currentColor; border-top: 2rpx solid currentColor; transform: rotate(45deg); }
.reminders-page .rule-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 22rpx 0; border-top: 1rpx solid var(--card-border); }
.reminders-page .rule-row:last-child { padding-bottom: 0; }
.reminders-page .rule-description { flex: 1; min-width: 0; font-size: 25rpx; line-height: 1.7; overflow-wrap: break-word; }
.reminders-page .rule-state { display: flex; align-items: center; justify-content: center; flex-shrink: 0; gap: 8rpx; margin-top: 2rpx; padding: 4rpx 12rpx; border-radius: 8rpx; font-size: 21rpx; line-height: 1.6; }
.reminders-page .is-enabled { color: var(--text); background: var(--ohlc-bg); }
.reminders-page .state-dot { width: 8rpx; height: 8rpx; flex-shrink: 0; border-radius: 50%; background: var(--status-ok); }
.reminders-page .is-paused { color: var(--text-mid); background: var(--chip-bg); }
.reminders-page .empty { padding: 48rpx 30rpx; text-align: center; }
.reminders-page .empty-mark { width: 64rpx; margin: 0 auto 24rpx; padding: 24rpx 18rpx; border: 1rpx solid var(--chip-border); border-radius: 20rpx; background: var(--ohlc-bg); }
.reminders-page .empty-line { height: 3rpx; border-radius: 2rpx; background: var(--text-mid); }
.reminders-page .empty-line.short { width: 60%; margin-top: 14rpx; }
.reminders-page .empty-title { font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.reminders-page .muted { margin-top: 12rpx; color: var(--text-mid); font-size: 24rpx; line-height: 1.8; }
.reminders-page .empty .muted text { display: inline-block; }
.reminders-page .recent-card { padding-top: 8rpx; padding-bottom: 8rpx; }
.reminders-page .recent-task { position: relative; display: flex; align-items: flex-start; gap: 20rpx; padding: 26rpx 0; }
.reminders-page .recent-task:not(:last-child)::after { position: absolute; top: 46rpx; bottom: -32rpx; left: 5rpx; width: 1rpx; background: var(--card-border); content: ""; }
.reminders-page .timeline-dot { position: relative; z-index: 1; flex-shrink: 0; width: 10rpx; height: 10rpx; margin-top: 14rpx; border-radius: 50%; background: var(--text-mid); }
.reminders-page .recent-task:first-child .timeline-dot { background: var(--accent); }
.reminders-page .task-content { flex: 1; min-width: 0; }
.reminders-page .task-heading { flex-wrap: wrap; gap: 8rpx 20rpx; align-items: baseline; }
.reminders-page .task-name { font-size: 25rpx; font-weight: 500; line-height: 1.6; overflow-wrap: break-word; }
.reminders-page .task-status { color: var(--text-mid); font-size: 22rpx; line-height: 1.6; }
.reminders-page .task-reason { margin-top: 10rpx; color: var(--text-mid); font-size: 23rpx; line-height: 1.75; overflow-wrap: break-word; }
.reminders-page .task-time { margin-top: 10rpx; color: var(--text-mid); font-size: 21rpx; line-height: 1.7; font-variant-numeric: tabular-nums; }
.reminders-page .reminder-guide { margin: 30rpx 6rpx 0; padding-top: 24rpx; border-top: 1rpx solid var(--card-border); }
.reminders-page .guide-heading { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; color: var(--text-mid); font-size: 23rpx; font-weight: 500; line-height: 1.6; }
.reminders-page .monitor-mark { width: 8rpx; height: 8rpx; border: 2rpx solid var(--text-mid); border-radius: 50%; }
.reminders-page .guide-copy { margin-top: 8rpx; color: var(--text-mid); font-size: 21rpx; line-height: 1.85; }
.reminders-page .error-bar { margin-bottom: 24rpx; padding: 22rpx 24rpx; border-radius: 16rpx; background: var(--error-bg); color: var(--error-text); font-size: 24rpx; line-height: 1.7; }
