<page-meta page-style="background-color: {{theme === 'blackgold' ? '#14120b' : '#f4f1ea'}};" background-color="{{theme === 'blackgold' ? '#14120b' : '#f4f1ea'}}" root-background-color="{{theme === 'blackgold' ? '#14120b' : '#f4f1ea'}}" />
<import src="../../templates/reminder-settings.wxml" />
<import src="../../templates/reminder-authorization.wxml" />
<view class="page reminders-page tab-page theme-{{theme}}">
  <view class="reminders-header">
    <view class="hero-title">行情提醒</view>
    <view class="hero-sub">增加授权、设置条件、管理提醒，在这里完成。</view>
  </view>

  <view wx:if="{{errorText}}" class="error-bar" role="alert">{{errorText}}</view>
  <template is="reminder-authorization" data="{{hasStatus, quota, authBusy, authError, authNote}}" />
  <view id="inline-settings" class="inline-settings asset-alert-page">
    <view class="section-heading list-heading"><view class="section-title">在这里设置提醒</view><text class="section-caption">{{activeCount}} / {{limits.activeRules}} 条启用</text></view>
    <picker wx:if="{{assets.length}}" range="{{assets}}" range-key="name" value="{{assetIndex}}" bindchange="onAssetChange" disabled="{{busy || editing}}" aria-label="选择设置提醒的标的">
      <view class="asset-selector"><view><view class="section-caption">选择标的{{editing ? ' · 完成或取消编辑后可切换' : ''}}</view><view class="asset-title">{{asset.name}}</view><view class="asset-code">{{asset.code}} · {{asset.marketText}} · {{asset.unit}}</view></view><text>切换</text></view>
    </picker>
    <view wx:if="{{asset && following}}" class="inline-editor"><template is="reminder-settings" data="{{asset, rules, types, editing, draft, pctOptions, pctIndex, busy, errorText, editLabel, theme, statusNote, prefs, dndBusy, dndError, dndNote}}" /></view>
    <view wx:if="{{asset && !following}}" class="reminder-card"><view class="muted">该标的已移出自选，重新加入后可设置提醒。</view><button class="ui-btn ui-primary" bindtap="follow" disabled="{{busy}}" loading="{{busy}}">重新加入自选</button></view>
  </view>

  <view class="section-heading list-heading">
    <view class="section-title">我的提醒</view>
    <text wx:if="{{hasPortfolio}}" class="section-caption">{{groups.length}} 个标的</text>
  </view>
  <view wx:if="{{loading}}" class="reminder-card empty" role="status">
    <view class="empty-title">正在加载提醒…</view>
    <view class="muted">正在整理你关注的标的和规则</view>
  </view>
  <view wx:elif="{{hasPortfolio && !groups.length}}" class="reminder-card empty">
    <view class="empty-mark" aria-hidden="true"><view class="empty-line"></view><view class="empty-line short"></view></view>
    <view class="empty-title">还没有设置提醒</view>
    <view class="muted">选择上方标的和提醒类型，即可在当前页设置。</view>
  </view>

  <button wx:for="{{groups}}" wx:key="id" class="reminder-card asset-card ui-row" data-id="{{item.id}}" bindtap="openAsset" disabled="{{busy || editing}}" hover-class="ui-pressed" aria-label="管理{{item.name}}提醒">
    <view class="section-heading asset-heading">
      <view class="asset-identity"><view class="asset-title">{{item.name}}</view><view class="asset-code">{{item.code}}<text wx:if="{{item.market}}"> · {{item.marketText}} · {{item.kindText}}</text></view></view>
      <view class="manage-link"><text>{{editing ? '请先完成编辑' : busy ? '正在保存' : '在本页设置'}}</text><view class="chevron" aria-hidden="true"></view></view>
    </view>
    <view class="rule-list">
      <view wx:for="{{item.rules}}" wx:for-item="rule" wx:key="id" class="rule-row">
        <view class="rule-description">{{rule.summary}}</view>
        <view class="rule-state {{rule.enabled ? 'is-enabled' : 'is-paused'}}"><view wx:if="{{rule.enabled}}" class="state-dot" aria-hidden="true"></view><text>{{rule.enabled ? '检测中' : '已暂停'}}</text></view>
      </view>
    </view>
  </button>

  <block wx:if="{{recent.length}}">
    <view class="section-heading list-heading"><view class="section-title">最近提醒</view><text class="section-caption">最近 {{recent.length}} 条</text></view>
    <view class="reminder-card recent-card">
      <view wx:for="{{recent}}" wx:key="taskId" class="recent-task">
        <view class="timeline-dot" aria-hidden="true"></view>
        <view class="task-content">
          <view class="section-heading task-heading"><text class="task-name">{{item.assetName}}</text><text class="task-status">{{item.statusText}}</text></view>
          <view wx:if="{{item.reasonText}}" class="task-reason">{{item.reasonText}}</view>
          <view class="task-time">{{item.timeText}}</view>
        </view>
      </view>
    </view>
  </block>

  <view class="reminder-guide">
    <view class="guide-heading"><view class="monitor-mark" aria-hidden="true"></view><text>提醒说明</text></view>
    <view class="guide-copy">后台约每 1 分钟监测，行情和推送均可能延迟。</view>
    <view class="guide-copy">每标的每类每日最多 1 条；每天常规最多 6 条、到价最多 4 条，共享微信授权次数。</view>
    <view class="guide-copy">免打扰时间可在上方直接修改，适用于全部提醒。</view>
  </view>
</view>
