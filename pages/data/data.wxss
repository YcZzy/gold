@import "../index/index.wxss";
.page{padding:28rpx 28rpx 60rpx}.card{margin-top:24rpx;padding:24rpx;border:1rpx solid var(--card-border);border-radius:24rpx;background:var(--card)}
.heading,.group-row,.setting{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.heading{font-size:28rpx;font-weight:600;flex-wrap:wrap}.group-row,.setting{padding:18rpx 0;border-bottom:1rpx solid var(--card-border);font-size:25rpx}.muted,.notice{color:var(--text-mid);font-size:23rpx;line-height:1.8}.notice{margin-top:18rpx}.actions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.page button{width:auto;min-height:76rpx;margin:0;padding:16rpx 22rpx;background:var(--chip-bg);color:var(--text);border:1rpx solid var(--chip-border);border-radius:14rpx;font-size:24rpx;line-height:1.6}label,.field-label{display:block;margin-top:18rpx;font-size:24rpx;line-height:1.7}.member{display:flex;align-items:center;gap:12rpx;padding:8rpx 0}.editor,.preview-row{margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid var(--card-border)}input,textarea{display:block;box-sizing:border-box;width:100%;margin-top:12rpx;padding:18rpx;border:1rpx solid var(--chip-border);border-radius:14rpx;background:var(--chip-bg);color:var(--text);font-size:25rpx;line-height:1.7}input{height:84rpx}textarea{height:220rpx}.export{height:180rpx}.picker{padding:18rpx;margin-top:16rpx;border:1rpx solid var(--chip-border);border-radius:14rpx;font-size:24rpx}.error-text{color:var(--error-text);font-size:24rpx;line-height:1.7}
