/* 页面独立排版，纸感 / 黑金配色由 app.wxss 提供。 */
.asset-alert-page { padding: 40rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.asset-alert-page .settings-header { margin: 0 4rpx 32rpx; }
.asset-alert-page .hero-title { font-size: 48rpx; font-weight: 600; line-height: 1.3; letter-spacing: 2rpx; }
.asset-alert-page .asset-identity { margin-top: 24rpx; padding-left: 20rpx; border-left: 4rpx solid var(--accent); }
.asset-alert-page .asset-name { font-size: 30rpx; font-weight: 600; line-height: 1.5; overflow-wrap: break-word; }
.asset-alert-page .asset-meta { margin-top: 6rpx; color: var(--text-mid); font-size: 22rpx; line-height: 1.7; font-variant-numeric: tabular-nums; overflow-wrap: break-word; }
.asset-alert-page button { box-sizing: border-box; margin: 0; line-height: 1.5; white-space: normal; }
.asset-alert-page button::after { border: none; }
.asset-alert-page button[disabled] { opacity: 0.5; }
.asset-alert-page .control-pressed { opacity: 0.7; }
.asset-alert-page .settings-card { padding: 30rpx; border: 1rpx solid var(--card-border); border-radius: 28rpx; background: var(--card); }
.asset-alert-page .section-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx 20rpx; }
.asset-alert-page .section-title { font-size: 29rpx; font-weight: 600; line-height: 1.5; }
.asset-alert-page .section-caption { color: var(--text-mid); font-size: 22rpx; line-height: 1.5; }
.asset-alert-page .muted { margin-top: 12rpx; color: var(--text-mid); font-size: 24rpx; line-height: 1.8; }
.asset-alert-page .helper { margin-top: 20rpx; color: var(--text-mid); font-size: 22rpx; line-height: 1.75; }
.asset-alert-page .type-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 26rpx; }
.asset-alert-page .type-button { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; width: 100%; min-width: 0; text-align: left; overflow-wrap: break-word; }
.asset-alert-page .type-label { font-size: 26rpx; font-weight: 500; line-height: 1.5; }
.asset-alert-page .type-description { margin-top: 6rpx; color: var(--text-mid); font-size: 21rpx; line-height: 1.6; }
.asset-alert-page .selected .type-description { color: var(--text-mid); }
.asset-alert-page .editor { margin-top: 24rpx; border-top: 4rpx solid var(--accent); }
.asset-alert-page .editor-badge { padding: 5rpx 14rpx; border: 1rpx solid var(--chip-border); border-radius: 8rpx; background: var(--chip-bg); color: var(--text-mid); font-size: 21rpx; line-height: 1.5; }
.asset-alert-page .field-label { color: var(--text-mid); font-size: 23rpx; line-height: 1.6; }
.asset-alert-page .price-editor { margin-top: 28rpx; }
.asset-alert-page .input-row { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; padding: 10rpx 22rpx; border: 1rpx solid var(--chip-border); border-radius: 16rpx; background: var(--ohlc-bg); }
.asset-alert-page .input-row input { flex: 1; min-width: 0; height: 88rpx; font-size: 36rpx; color: var(--text); font-variant-numeric: tabular-nums; }
.asset-alert-page .input-unit { max-width: 160rpx; flex-shrink: 0; color: var(--text-mid); font-size: 23rpx; line-height: 1.6; overflow-wrap: break-word; }
.asset-alert-page .picker-field { margin-top: 26rpx; padding: 22rpx 24rpx; border: 1rpx solid var(--chip-border); border-radius: 18rpx; background: var(--ohlc-bg); }
.asset-alert-page .picker-content { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 10rpx; }
.asset-alert-page .picker-value { font-size: 40rpx; font-weight: 600; line-height: 1.4; font-variant-numeric: tabular-nums; }
.asset-alert-page .value-unit { margin-left: 8rpx; color: var(--text-mid); font-size: 26rpx; font-weight: 400; }
.asset-alert-page .picker-chevron { flex-shrink: 0; width: 12rpx; height: 12rpx; margin-right: 4rpx; border-right: 2rpx solid var(--text-mid); border-bottom: 2rpx solid var(--text-mid); transform: translateY(-4rpx) rotate(45deg); }
.asset-alert-page .setting-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 112rpx; padding: 20rpx 0; box-sizing: border-box; font-size: 26rpx; line-height: 1.6; }
.asset-alert-page .setting-copy { flex: 1; min-width: 0; }
.asset-alert-page .setting-description { margin-top: 6rpx; color: var(--text-mid); font-size: 22rpx; line-height: 1.7; }
.asset-alert-page switch { display: flex; flex-shrink: 0; }
.asset-alert-page .enabled-setting { margin-top: 24rpx; border-top: 1rpx solid var(--card-border); }
.asset-alert-page .close-description { margin-top: 26rpx; padding: 22rpx 24rpx; border-radius: 16rpx; background: var(--ohlc-bg); color: var(--text-mid); font-size: 24rpx; line-height: 1.8; }
.asset-alert-page .editor-actions { margin-top: 12rpx; }
.asset-alert-page .primary { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; }
.asset-alert-page .follow-card .primary { margin-top: 26rpx; }
.asset-alert-page .cancel-button { display: flex; align-items: center; justify-content: center; width: 100%; margin-top: 8rpx; }
.asset-alert-page .rules-heading { margin: 36rpx 6rpx 18rpx; }
.asset-alert-page .rules-card { padding-top: 8rpx; padding-bottom: 8rpx; }
.asset-alert-page .rule-row { padding: 24rpx 0; border-top: 1rpx solid var(--card-border); }
.asset-alert-page .rule-row:first-child { border-top: 0; }
.asset-alert-page .rule-copy { display: block; width: 100%; min-width: 0; min-height: 88rpx; padding: 4rpx 0 14rpx; border-radius: 0; background: transparent; color: var(--text); text-align: left; }
.asset-alert-page .rule-summary { font-size: 26rpx; font-weight: 500; line-height: 1.75; overflow-wrap: break-word; }
.asset-alert-page .edit-hint { display: flex; align-items: center; gap: 10rpx; margin-top: 8rpx; color: var(--text-mid); font-size: 22rpx; line-height: 1.6; }
.asset-alert-page .chevron { width: 10rpx; height: 10rpx; border-right: 2rpx solid currentColor; border-top: 2rpx solid currentColor; transform: rotate(45deg); }
.asset-alert-page .rule-actions { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 12rpx; }
.asset-alert-page .rule-toggle { display: flex; align-items: center; gap: 12rpx; min-height: 88rpx; }
.asset-alert-page .rule-status { font-size: 22rpx; color: var(--text-mid); }
.asset-alert-page .rule-delete { display: flex; align-items: center; justify-content: center; width: auto; min-width: 104rpx; }
.asset-alert-page .empty-rules { padding: 36rpx 0; text-align: center; }
.asset-alert-page .empty-title { font-size: 27rpx; font-weight: 500; line-height: 1.6; }
.asset-alert-page .page-footer { margin: 30rpx 6rpx 0; padding-top: 24rpx; border-top: 1rpx solid var(--card-border); color: var(--text-mid); font-size: 21rpx; line-height: 1.85; }
.asset-alert-page .footer-title { margin-bottom: 10rpx; font-size: 23rpx; font-weight: 500; }
.asset-alert-page .loading-note { margin-bottom: 24rpx; color: var(--text-mid); font-size: 24rpx; line-height: 1.7; }
.asset-alert-page .error-bar { margin: 24rpx 0; padding: 22rpx 24rpx; border-radius: 16rpx; background: var(--error-bg); color: var(--error-text); font-size: 24rpx; line-height: 1.7; overflow-wrap: break-word; }
