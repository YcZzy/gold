@import "../index/index.wxss";

/* Native button minimum widths must not determine the grid track size. */
.type-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.page .type-button {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  margin: 0;
  white-space: normal;
  overflow-wrap: break-word;
}

.hero-title,
.rule-copy {
  min-width: 0;
  overflow-wrap: break-word;
}

.rule-row {
  padding: 24rpx 0;
}

.rule-row:last-child {
  padding-bottom: 0;
}

.rule-copy .micro {
  display: block;
  margin-top: 6rpx;
  color: var(--text-sub);
}

.rule-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  min-height: 88rpx;
}

.rule-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  min-height: 88rpx;
}

.setting-row switch,
.rule-toggle switch {
  display: flex;
  flex-shrink: 0;
}

.rule-status {
  font-size: 22rpx;
  color: var(--text-sub);
}

.page .rule-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  width: auto;
  min-width: 96rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 14rpx 20rpx;
  border: 1rpx solid var(--chip-border);
  border-radius: 12rpx;
  background: transparent;
  color: var(--text-sub);
  font-size: 22rpx;
}

/* Keep native button defaults from overriding form and grid widths. */
.page .primary,
.page .text-button {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  margin-left: 0;
  margin-right: 0;
}

.page .primary {
  min-height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.page .text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  color: var(--text-mid);
}

.page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.hero-title {
  letter-spacing: normal;
  font-size: 36rpx;
  line-height: 1.45;
}

.hero-sub {
  margin-top: 8rpx;
  color: var(--text-mid);
  font-variant-numeric: tabular-nums;
}

.panel {
  padding: 28rpx;
  border-radius: 24rpx;
}

.section-title {
  margin-bottom: 0;
  line-height: 1.5;
}

.type-grid {
  gap: 16rpx;
  margin-top: 24rpx;
}

.page .type-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 18rpx 10rpx;
  line-height: 1.5;
  border-radius: 14rpx;
}

.page .type-button.selected {
  background: var(--intl-bg);
  border-color: var(--accent);
  color: var(--accent);
  font-weight: 600;
}

.panel .foot {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--text-mid);
}

.field-label {
  margin-top: 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-mid);
}

.input-row {
  margin: 12rpx 0;
  padding: 8rpx 20rpx;
  background: var(--chip-bg);
  border: 1rpx solid var(--chip-border);
  border-radius: 14rpx;
}

.input-row input {
  color: var(--text);
  line-height: 1.4;
}

.input-row .muted {
  flex-shrink: 0;
  color: var(--text-mid);
}

.setting-row {
  min-height: 104rpx;
}

.setting-row > text {
  flex: 1;
  min-width: 0;
  line-height: 1.5;
}

.picker-row {
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 12rpx 0;
}

.picker-row > text:first-child {
  min-width: 0;
  flex: 1;
  line-height: 1.5;
}

.picker-value {
  flex-shrink: 0;
  color: var(--text);
}

.picker-arrow {
  flex-basis: 32rpx;
  width: 32rpx;
  margin-left: 0;
}

.rule-copy {
  color: var(--text);
  padding: 8rpx 0;
}

.rule-copy .micro,
.rule-status {
  color: var(--text-mid);
}

.rule-row {
  margin-top: 24rpx;
}

.rule-actions {
  margin-top: 8rpx;
}

.muted {
  margin-top: 16rpx;
  color: var(--text-mid);
}

.input-row .muted {
  margin-top: 0;
}

.error-bar {
  margin: 24rpx 0 0;
  overflow-wrap: break-word;
}

.page > .foot {
  color: var(--text-mid);
  font-size: 22rpx;
}
