<page-meta page-style="background-color: {{theme === 'blackgold' ? '#14120b' : '#f4f1ea'}};" background-color="{{theme === 'blackgold' ? '#14120b' : '#f4f1ea'}}" root-background-color="{{theme === 'blackgold' ? '#14120b' : '#f4f1ea'}}" />
<view class="page market-page theme-{{theme}} {{quiet ? 'quiet-mode' : ''}}">
  <view class="heading">
    <view><view class="eyebrow">MARKET · 看盘发现</view><view class="title">市场脉络</view><view class="hero-sub">从指数到板块，发现值得关注的行情</view></view>
  </view>

  <view class="section-caption"><view class="section-label">主要指数<text class="count">{{indexIds.length}} 个关注</text></view><button class="text-button ui-btn ui-text" bindtap="toggleIndexEditor" aria-expanded="{{indexEditing}}" aria-controls="index-editor" hover-class="ui-pressed">{{indexEditing ? '收起编辑' : '管理指数'}}</button></view>
  <view wx:if="{{indexEditing}}" id="index-editor" class="panel index-editor">
    <view class="panel-title">选择关注指数</view><view class="hint">仅在本设备保存，独立于股票自选。</view>
    <checkbox-group bindchange="onIndexChoice" aria-label="选择关注指数" class="index-choices">
      <label wx:for="{{indexOptions}}" wx:key="id" class="choice"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="{{theme === 'blackgold' ? '#d9b45b' : '#2c2c2a'}}" /><text>{{item.name}}</text></label>
    </checkbox-group>
    <view class="hint">可全部取消；指数不创建股票资产或提醒。</view>
    <view class="editor-actions"><button class="secondary ui-btn ui-secondary" bindtap="toggleIndexEditor" hover-class="ui-pressed">取消</button><button class="primary ui-btn ui-primary" bindtap="saveIndexChoices" hover-class="ui-pressed">保存选择 · {{indexDraft.length}}</button></view>
  </view>
  <scroll-view wx:if="{{indices.length}}" class="index-scroll" scroll-x enhanced show-scrollbar="{{false}}" aria-label="关注指数，可横向滑动">
    <view class="index-track">
      <view wx:for="{{indices}}" wx:key="id" class="index-card">
        <view class="index-name">{{item.name}}</view><view class="index-price {{item.cls}}">{{item.priceText}}</view>
        <view class="index-change"><text class="change-pill {{item.cls}}">{{item.pctText}}</text><text class="index-status">{{item.statusText}}</text></view>
        <view class="index-time">{{item.timeText}}</view>
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{!indexLoading && !indices.length && !indexError}}" class="empty index-empty"><view class="empty-title">定制你的指数看板</view><view>选择关注指数，快速了解市场方向。</view><button class="secondary ui-btn ui-secondary" bindtap="toggleIndexEditor" hover-class="ui-pressed">选择指数</button></view>
  <view class="module-status"><text wx:if="{{indexLoading}}" role="status">指数正在更新…</text><text wx:else>{{indexNotice || '指数点位 · 公开行情快照'}}</text><button class="text-button refresh-action ui-btn ui-text" bindtap="loadIndices" disabled="{{indexLoading}}" aria-label="刷新主要指数" hover-class="ui-pressed"><view class="refresh-icon" aria-hidden="true"></view><text class="refresh-label">{{indexLoading ? '更新中' : '刷新指数'}}</text></button></view>
  <view wx:if="{{indexError}}" class="error" role="alert"><text>{{indexError}}</text><button class="text-button ui-btn ui-text" bindtap="loadIndices" disabled="{{indexLoading}}" hover-class="ui-pressed">重试指数</button></view>

  <view class="discovery-panel">
    <view class="discovery-heading"><view class="panel-title">行情发现</view><text class="section-note">榜单 · 板块 · 资金</text></view>
    <view class="section-tabs" role="group" aria-label="发现榜单类型"><button wx:for="{{sections}}" wx:key="value" class="tab {{section === item.value ? 'selected' : ''}} ui-tab {{section === item.value ? 'ui-selected' : ''}}" bindtap="switchSection" data-value="{{item.value}}" aria-pressed="{{section === item.value}}" hover-class="ui-pressed">{{item.label}}</button></view>
    <view wx:if="{{selectedSector}}" class="member-heading"><button class="text-button ui-btn ui-text" bindtap="closeSector" hover-class="ui-pressed">‹ 返回{{section === 'industry' ? '行业' : '概念'}}</button><text>{{selectedSector.name}}</text></view>
    <view wx:if="{{section === 'ranking' || selectedSector}}" class="sort-tabs" role="group" aria-label="个股排序"><button wx:for="{{rankSorts}}" wx:key="value" class="sort {{sort === item.value ? 'sort-on' : ''}} ui-btn ui-choice {{sort === item.value ? 'ui-selected' : ''}}" bindtap="selectSort" data-value="{{item.value}}" aria-pressed="{{sort === item.value}}" hover-class="ui-pressed">{{item.label}}{{sort === item.value ? (sort === 'losers' ? ' ↑' : ' ↓') : ''}}</button></view>
    <view wx:if="{{(section === 'industry' || section === 'concept') && !selectedSector}}" class="sector-tools">
      <label class="field-label" for="sector-search">搜索{{section === 'industry' ? '行业' : '概念'}}</label>
      <view class="search-row"><view class="search-field"><input id="sector-search" value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="searchSectors" maxlength="40" confirm-type="search" placeholder="板块名称或代码" placeholder-class="search-placeholder" aria-label="板块搜索" /><button wx:if="{{keyword || searchKeyword}}" class="clear-search ui-btn ui-text" bindtap="clearSearch" aria-label="清空板块搜索" hover-class="ui-pressed">清空</button></view><button class="search-button ui-btn ui-primary" bindtap="searchSectors" hover-class="ui-pressed">搜索</button></view>
      <view class="sector-sort-row"><text class="field-label">{{searchKeyword ? '当前搜索：' + searchKeyword : '浏览全部板块'}}</text><picker id="sector-sort" mode="selector" range="{{sectorSortLabels}}" value="{{sectorSortIndex}}" bindchange="onSectorSort" aria-label="选择板块排序"><view class="picker-value">{{sectorSortLabels[sectorSortIndex]}}<text aria-hidden="true">⌄</text></view></picker></view>
    </view>
    <view wx:if="{{isFlow}}" class="flow-note">主力净额为成交单大小分类估算，仅供观察。</view>
    <view class="list-heading"><view class="list-title">{{listTitle}}</view><button class="text-button refresh-action ui-btn ui-text" bindtap="loadList" disabled="{{listLoading}}" aria-label="刷新当前榜单" hover-class="ui-pressed"><view class="refresh-icon" aria-hidden="true"></view><text class="refresh-label">{{listLoading ? '更新中' : '刷新榜单'}}</text></button></view>
    <view wx:if="{{listError}}" class="error" role="alert"><text>{{listError}}</text><button class="text-button ui-btn ui-text" bindtap="loadList" disabled="{{listLoading}}" hover-class="ui-pressed">重试榜单</button></view>
    <view wx:if="{{listLoading}}" class="loading-status hint" role="status">{{rows.length ? '正在更新，以下为上次快照…' : '正在获取行情…'}}</view>
    <view wx:if="{{listLoading && !rows.length}}" class="skeleton-list" aria-hidden="true"><view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="skeleton-row"><view><view class="skeleton-line skeleton-name"></view><view class="skeleton-line skeleton-code"></view></view><view class="skeleton-line skeleton-number"></view></view></view>
    <view wx:if="{{!listLoading && !rows.length && !listError}}" class="empty"><view class="empty-title">暂无符合条件的行情</view><view>试试其他搜索词或排序方式。</view><button wx:if="{{searchKeyword && isSector}}" class="secondary ui-btn ui-secondary" bindtap="clearSearch" hover-class="ui-pressed">清空搜索，查看全部</button></view>
    <view wx:if="{{rows.length}}" class="table-caption"><text>{{isSector ? '板块 / 领涨股' : '证券 / 代码'}}</text><text>{{isFlow ? '主力净额估算' : isSector ? '涨跌幅 / 成交额' : '现价 / 涨跌幅'}}</text></view>
    <view class="market-list" aria-busy="{{listLoading}}">
      <view wx:for="{{rows}}" wx:key="key" class="market-row">
        <block wx:if="{{isSector}}">
          <button class="sector-row ui-row" bindtap="openSector" data-id="{{item.id}}" data-name="{{item.name}}" aria-label="查看{{item.name}}成员" hover-class="ui-pressed">
            <text class="rank {{item.rank <= 3 ? 'rank-top' : ''}}">{{item.rank}}</text><view class="row-identity"><view class="row-name">{{item.name}}</view><view class="row-meta">领涨 {{item.leaderName || '--'}}</view><view class="row-meta">成员 {{item.count == null ? '--' : item.count}} · {{item.id}}</view></view>
            <view class="row-numbers"><view class="change-pill {{item.cls}}">{{item.pctText}}</view><view class="row-meta">{{item.amountText}}</view><view class="member-link">查看成员 ›</view></view>
          </button>
        </block>
        <block wx:else>
          <view class="security-row"><text class="rank {{item.rank <= 3 ? 'rank-top' : ''}}">{{item.rank}}</text><button class="asset-button ui-row" bindtap="openAsset" data-id="{{item.assetId}}" aria-label="查看{{item.name || item.asset.name}}行情详情" hover-class="ui-pressed"><view class="row-name">{{item.name || item.asset.name}}</view><view class="row-meta security-code">{{item.assetId}}</view></button><view class="row-numbers"><view wx:if="{{isFlow}}" class="flow-number {{item.cls}}">{{item.flowText}}</view><block wx:else><view class="row-price">{{item.priceText}}</view><view class="change-pill {{item.cls}}">{{item.pctText}}</view></block></view></view>
          <view class="row-footer"><view class="row-footnote"><view wx:if="{{!isFlow}}" class="row-meta">成交额 {{item.amountText}}</view><view wx:if="{{item.clock}}" class="row-meta">源时刻 {{item.clock}}</view><view wx:if="{{isFlow && item.sourceTimeText}}" class="row-meta">行情来源 {{item.sourceTimeText}}</view><view wx:if="{{!item.canAdd}}" class="hint">暂无有效报价，仅保留成员身份</view></view><button wx:if="{{followingMap[item.assetId]}}" class="add-button is-following ui-btn ui-secondary ui-complete" disabled aria-label="{{item.name || item.asset.name}}已加入自选" hover-class="ui-pressed">✓ 已自选</button><button wx:else class="add-button ui-btn ui-secondary" bindtap="addAsset" data-id="{{item.assetId}}" disabled="{{!!rowBusy || !item.canAdd}}" loading="{{rowBusy === item.assetId}}" aria-label="将{{item.name || item.asset.name}}加入自选" hover-class="ui-pressed">＋ 自选</button></view>
          <view wx:if="{{rowErrorId === item.assetId}}" class="row-error" role="alert">{{rowError}}</view>
        </block>
      </view>
    </view>
    <view wx:if="{{rows.length || listPage > 1}}" class="pagination" role="group" aria-label="榜单分页">
      <button class="page-step ui-btn ui-text" bindtap="previousPage" disabled="{{listLoading || listPage <= 1}}" aria-label="上一页榜单" hover-class="ui-pressed"><view class="page-arrow page-arrow-prev" aria-hidden="true"></view><text>上一页</text></button>
      <view class="page-indicator" aria-label="当前第{{listPage}}页"><view class="page-number"><text class="page-prefix">第</text><text class="page-current">{{listPage}}</text><text class="page-prefix">页</text></view><view wx:if="{{!listLoading && (!hasMore || listPage >= 10)}}" class="page-limit">{{listPage >= 10 ? '已达页数上限' : '最后一页'}}</view></view>
      <button class="page-step ui-btn ui-text" bindtap="nextPage" disabled="{{listLoading || !hasMore || listPage >= 10}}" aria-label="下一页榜单" hover-class="ui-pressed"><text>下一页</text><view class="page-arrow page-arrow-next" aria-hidden="true"></view></button>
    </view>
    <view wx:if="{{listTime || scope}}" class="provenance"><view wx:if="{{listTime}}">{{listTime}}</view><view wx:if="{{scope}}">{{scope}}</view></view>
  </view>
  <view class="disclaimer"><view class="disclaimer-title">关于这些行情</view><view>板块为新浪供应商分类，可能包含非 A 股；行业与概念并非互斥，不可加总。资金为东方财富按成交单大小估算，不代表机构身份或北向资金。榜单时刻未附日期时仅标获取时间。</view><view class="disclaimer-end">公开行情可能延迟，仅供个人观察。</view></view>
</view>
