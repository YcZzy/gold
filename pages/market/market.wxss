/* Market overview: compact index strip and a single, readable discovery sheet. */
.market-page { padding: 40rpx 32rpx 80rpx; padding-bottom: calc(80rpx + env(safe-area-inset-bottom)); }
.heading { margin-bottom: 30rpx; }
.eyebrow { font-size: 20rpx; letter-spacing: 3rpx; color: var(--text-sub); }
.title { margin-top: 12rpx; font-size: 48rpx; font-weight: 600; font-family: "Songti SC", "STSong", serif; letter-spacing: 2rpx; }
.hero-sub { margin-top: 14rpx; font-size: 23rpx; color: var(--text-mid); line-height: 1.7; }
button { box-sizing: border-box; margin: 0; padding: 0; border-radius: 0; background: transparent; color: var(--text); line-height: 1.5; text-align: left; font-size: 26rpx; }
button::after { border: 0; }
button[disabled] { opacity: .5; }
button:focus-visible, input:focus-visible { outline: 3rpx solid var(--accent); outline-offset: 4rpx; }
.control-pressed { opacity: .72; }
.row-pressed { opacity: .65; }
/* Placement only; button appearance comes from styles/buttons.wxss. */
.text-button { display: flex; align-items: center; justify-content: center; gap: 10rpx; flex-shrink: 0; }
/* Draw the refresh mark in a square box instead of using a font glyph baseline. */
.refresh-action { width: auto; flex: 0 0 auto; }
.refresh-label { display: block; line-height: 28rpx; }
.refresh-icon { position: relative; display: block; box-sizing: border-box; width: 24rpx; height: 24rpx; flex: 0 0 24rpx; }
.refresh-icon::before { content: ''; position: absolute; inset: 2rpx; box-sizing: border-box; border: 2rpx solid currentColor; border-right-color: transparent; border-radius: 50%; transform: rotate(-30deg); }
.refresh-icon::after { content: ''; position: absolute; top: 1rpx; right: 1rpx; box-sizing: border-box; width: 8rpx; height: 8rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; }
.module-status, .list-heading, .section-caption { padding-top: 8rpx; padding-bottom: 8rpx; }
.section-caption, .section-label, .module-status, .discovery-heading, .list-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.section-label { justify-content: flex-start; font-size: 28rpx; font-weight: 600; }
.count { font-size: 20rpx; font-weight: 400; color: var(--text-sub); }
.panel { padding: 24rpx; background: var(--card); border: 1rpx solid var(--card-border); border-radius: 20rpx; }
.panel-title { font-size: 30rpx; font-weight: 600; }
.hint { color: var(--text-mid); font-size: 22rpx; line-height: 1.8; }
.index-editor { margin: 4rpx 0 20rpx; }
.index-choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 16rpx 0; }
.choice { display: flex; align-items: center; min-height: 72rpx; font-size: 24rpx; min-width: 0; }
.choice text { flex: 1; min-width: 0; overflow-wrap: break-word; }
.editor-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.primary, .secondary { display: flex; align-items: center; justify-content: center; }
.primary { flex: 1; }
.index-scroll { width: 100%; }
.index-track { display: flex; gap: 16rpx; padding: 4rpx 0 8rpx; }
.index-card { box-sizing: border-box; flex: 0 0 288rpx; width: 288rpx; padding: 24rpx; background: var(--card); border: 1rpx solid var(--card-border); border-radius: 20rpx; }
.index-name { font-size: 25rpx; font-weight: 500; line-height: 1.5; }
.index-price { margin-top: 14rpx; font-size: 40rpx; font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: -1rpx; }
.index-change { display: flex; gap: 10rpx; align-items: center; justify-content: space-between; margin: 10rpx 0 16rpx; }
.index-status { font-size: 18rpx; color: var(--text-mid); }
.index-time { min-height: 58rpx; font-size: 19rpx; color: var(--text-mid); line-height: 1.6; overflow-wrap: anywhere; }
.change-pill { display: inline-block; box-sizing: border-box; padding: 5rpx 12rpx; border-radius: 8rpx; font-size: 24rpx; line-height: 1.5; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
.change-pill.up { background: var(--pill-up); }
.change-pill.down { background: var(--pill-down); }
.change-pill.flat { background: var(--pill-flat); }
.module-status { font-size: 20rpx; color: var(--text-sub); margin: 4rpx 0 22rpx; }
.module-status > text { min-width: 0; line-height: 1.7; overflow-wrap: anywhere; }
/* Shared filters sit above the rows and retain a stable hierarchy. */
.discovery-panel { background: var(--card); border: 1rpx solid var(--card-border); border-radius: 24rpx; padding: 28rpx 24rpx 8rpx; }
.discovery-heading { margin-bottom: 24rpx; }
.section-note { font-size: 20rpx; color: var(--text-sub); }
.section-tabs { display: flex; gap: 12rpx; padding: 0; border-bottom: 1rpx solid var(--card-border); }
.tab { flex: 1; display: flex; justify-content: center; align-items: center; min-width: 0; text-align: center; }
/* Constrain native button widths so all three sort options fit the panel. */
.sort-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; width: 100%; min-width: 0; box-sizing: border-box; margin: 20rpx 0 8rpx; }
.sort-tabs .sort { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-width: 0; max-width: 100%; margin: 0; }
.member-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; border-bottom: 1rpx solid var(--card-border); margin-top: 12rpx; }
.member-heading > text { min-width: 0; font-size: 25rpx; overflow-wrap: anywhere; }
.sector-tools { margin-top: 24rpx; }
.field-label { display: block; min-width: 0; font-size: 22rpx; color: var(--text-mid); line-height: 1.6; overflow-wrap: anywhere; }
.search-row { display: flex; gap: 12rpx; margin-top: 12rpx; }
.search-field { flex: 1; min-width: 0; display: flex; align-items: center; background: var(--chip-bg); border: 1rpx solid var(--chip-border); border-radius: 12rpx; }
.search-field input { flex: 1; min-width: 0; height: 72rpx; padding: 0 16rpx; box-sizing: border-box; font-size: 24rpx; }
.search-placeholder { color: var(--text-sub); }
.clear-search { display: flex; align-items: center; flex-shrink: 0; }
.search-button { display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.sector-sort-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; }
.sector-sort-row picker { flex-shrink: 0; }
.picker-value { display: flex; align-items: center; gap: 14rpx; min-height: 56rpx; padding: 8rpx 0 8rpx 12rpx; box-sizing: border-box; border: 0; background: transparent; font-size: 23rpx; color: var(--text); }
.flow-note { margin-top: 20rpx; color: var(--text-mid); font-size: 22rpx; line-height: 1.7; }
.list-heading { margin-top: 12rpx; }
.list-title { min-width: 0; font-size: 25rpx; font-weight: 600; overflow-wrap: anywhere; }
.loading-status { padding: 8rpx 0 16rpx; }
.table-caption { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; border-bottom: 1rpx solid var(--card-border); padding: 12rpx 0 20rpx 48rpx; color: var(--text-sub); font-size: 20rpx; }
/* Separate identity and quote columns; long names wrap without moving quotes. */
.market-row { padding: 24rpx 0; border-bottom: 1rpx solid var(--card-border); }
.sector-row, .security-row { display: flex; align-items: flex-start; gap: 16rpx; width: 100%; }
.rank { flex: 0 0 32rpx; width: 32rpx; padding-top: 6rpx; color: var(--text-sub); font-size: 21rpx; font-variant-numeric: tabular-nums; text-align: center; }
.rank-top { color: var(--accent); font-weight: 600; }
.row-identity, .asset-button { flex: 1; min-width: 0; }
.asset-button { min-height: 72rpx; border-radius: 6rpx; }
.row-name { font-size: 28rpx; font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; }
.row-meta { font-size: 20rpx; color: var(--text-mid); line-height: 1.8; overflow-wrap: anywhere; }
.security-code { margin-top: 6rpx; font-variant-numeric: tabular-nums; }
.row-numbers { flex-shrink: 0; max-width: 48%; text-align: right; font-variant-numeric: tabular-nums; }
.row-price { font-size: 30rpx; font-weight: 600; line-height: 1.5; margin-bottom: 6rpx; overflow-wrap: anywhere; }
.flow-number { font-size: 28rpx; font-weight: 600; line-height: 1.6; overflow-wrap: anywhere; }
.member-link { font-size: 21rpx; line-height: 1.8; margin-top: 8rpx; color: var(--accent); }
.row-footer { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding-left: 48rpx; margin-top: 12rpx; }
.row-footnote { flex: 1; min-width: 0; }
.add-button { display: flex; align-items: center; justify-content: center; min-width: 112rpx; flex-shrink: 0; white-space: nowrap; }
.add-button.is-following { opacity: 1; }
.row-error { padding: 12rpx 0 0 48rpx; font-size: 22rpx; color: var(--error-text); line-height: 1.7; }
.error { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 16rpx 20rpx; background: var(--error-bg); border-radius: 12rpx; color: var(--error-text); font-size: 23rpx; line-height: 1.8; margin: 12rpx 0; }
.error > text { min-width: 0; overflow-wrap: anywhere; }
.empty { padding: 48rpx 16rpx; color: var(--text-mid); font-size: 23rpx; line-height: 1.8; text-align: center; }
.empty-title { color: var(--text); font-size: 28rpx; font-weight: 500; margin-bottom: 10rpx; }
.empty .secondary { display: inline-flex; margin-top: 24rpx; }
.index-empty { border: 1rpx dashed var(--chip-border); border-radius: 20rpx; }
/* Equal grid tracks keep native button widths inside the panel. */
.pagination { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 12rpx; box-sizing: border-box; width: 100%; min-width: 0; padding: 20rpx 12rpx; }
.pagination .page-step { box-sizing: border-box; width: 100%; min-width: 0; max-width: 100%; margin: 0; white-space: nowrap; }
.page-arrow { width: 10rpx; height: 10rpx; box-sizing: border-box; border-top: 2rpx solid currentColor; border-right: 2rpx solid currentColor; flex-shrink: 0; }
.page-arrow-prev { transform: rotate(-135deg); margin-right: 6rpx; }
.page-arrow-next { transform: rotate(45deg); margin-left: 6rpx; }
.page-indicator { min-width: 96rpx; text-align: center; }
.page-number { display: flex; align-items: baseline; justify-content: center; gap: 10rpx; line-height: 1.4; }
.page-prefix { font-size: 21rpx; color: var(--text-sub); }
.page-current { font-size: 30rpx; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }
.page-limit { margin-top: 4rpx; font-size: 18rpx; color: var(--text-sub); line-height: 1.5; }
.provenance { border-top: 1rpx solid var(--card-border); padding: 18rpx 4rpx; color: var(--text-sub); font-size: 20rpx; line-height: 1.8; overflow-wrap: anywhere; }
.disclaimer { padding: 28rpx 4rpx 0; color: var(--text-mid); font-size: 20rpx; line-height: 1.9; }
.disclaimer-title { margin-bottom: 10rpx; font-size: 23rpx; color: var(--text); }
.disclaimer-end { margin-top: 12rpx; color: var(--text-sub); }
/* Static placeholders avoid continuous animation during slow source responses. */
.skeleton-row { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid var(--card-border); }
.skeleton-line { background: var(--chip-bg); border-radius: 6rpx; height: 24rpx; }
.skeleton-name { width: 180rpx; }
.skeleton-code { width: 112rpx; height: 18rpx; margin-top: 16rpx; }
.skeleton-number { width: 120rpx; height: 42rpx; }
@media (max-width: 360px) {
  .market-page { padding-left: 24rpx; padding-right: 24rpx; }
  .discovery-panel { padding-left: 20rpx; padding-right: 20rpx; }
  .section-note { font-size: 19rpx; }
  .row-name { font-size: 26rpx; }
  .row-numbers { max-width: 46%; }
}
