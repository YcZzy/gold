@import "../index/index.wxss";

.search-page {
  padding: 40rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}

.search-page .hero-title {
  font-size: 44rpx;
  letter-spacing: normal;
}

.search-page .hero-sub {
  margin-top: 12rpx;
  color: var(--text-mid);
  font-size: 24rpx;
}

.search-page .search-box {
  gap: 18rpx;
  margin: 28rpx 0 0;
  padding: 12rpx 12rpx 12rpx 24rpx;
  border-radius: 20rpx;
  background: var(--card);
}

.search-symbol {
  position: relative;
  box-sizing: border-box;
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  margin-right: 2rpx;
  border: 3rpx solid var(--text-mid);
  border-radius: 50%;
}

.search-symbol::after {
  content: "";
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--text-mid);
  transform: rotate(45deg);
}

.search-page .search-input {
  height: 72rpx;
  color: var(--text);
  font-size: 27rpx;
}

.search-placeholder {
  color: var(--text-sub);
}

/* Scope widths to beat the native button default. */
.search-page .search-submit,
.search-page .history-chip,
.search-page .result-add {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  width: auto;
  min-width: 0;
  margin: 0;
  line-height: 1.5;
}

.search-page .search-submit {
  min-height: 72rpx;
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
  color: var(--btn-text);
  background: var(--btn-bg);
  font-size: 25rpx;
}

.search-page .history-section {
  margin-top: 40rpx;
}

.search-page .section-title,
.search-page .results-heading {
  margin-bottom: 0;
  color: var(--text);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.5;
}

.search-page .chips {
  gap: 16rpx;
  margin-top: 22rpx;
}

.search-page .history-chip {
  max-width: 100%;
  min-height: 72rpx;
  padding: 14rpx 28rpx;
  border: 1rpx solid var(--card-border);
  border-radius: 36rpx;
  color: var(--text-mid);
  background: var(--card);
  font-size: 25rpx;
  white-space: normal;
  overflow-wrap: anywhere;
  text-align: left;
}

.search-page .results-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 36rpx;
  margin-bottom: 16rpx;
}

.search-page .results-count {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-mid);
}

.search-page .list {
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: var(--card);
}

.search-page .search-result {
  gap: 20rpx;
  min-height: 148rpx;
  box-sizing: border-box;
  padding: 24rpx 0;
}

.search-page .search-result:last-child {
  border-bottom: 0;
}

.search-page .name {
  font-size: 29rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.search-page .code {
  color: var(--text-mid);
  font-size: 21rpx;
  overflow-wrap: anywhere;
}

.search-page .result-add {
  gap: 8rpx;
  min-width: 156rpx;
  min-height: 72rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid var(--btn-bg);
  border-radius: 36rpx;
  background: var(--btn-bg);
  color: var(--btn-text);
  font-size: 24rpx;
  white-space: nowrap;
}

.search-page .result-add.is-added {
  opacity: 1;
  border-color: var(--chip-border);
  background: transparent;
  color: var(--text-mid);
}

.result-check {
  box-sizing: border-box;
  width: 9rpx;
  height: 16rpx;
  margin: -4rpx 6rpx 0 0;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: rotate(45deg);
}

.search-page .empty {
  padding: 64rpx 24rpx 40rpx;
  color: var(--text-mid);
  line-height: 1.7;
}

.search-page .empty-title {
  color: var(--text);
  font-size: 30rpx;
}

.search-page .empty .muted,
.search-page .foot {
  color: var(--text-mid);
  font-size: 22rpx;
}

.search-page .foot {
  margin-top: 32rpx;
  padding: 0 4rpx;
}
