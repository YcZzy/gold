.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 56rpx;
  color: var(--text);
  background: var(--bg);
}
.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.hero-title {
  font-size: 40rpx;
  line-height: 1.3;
  font-weight: 600;
  letter-spacing: -1rpx;
}
.hero-sub {
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--text-sub2);
  margin-top: 12rpx;
}
.count {
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 0;
  color: var(--text-sub2);
  margin-left: 8rpx;
}
button {
  margin: 0;
  font-size: 24rpx;
  border-radius: 12rpx;
  font-weight: 500;
  line-height: 1.5;
}
button::after {
  border: none;
}
button[disabled] {
  opacity: 0.45;
}
.primary {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  min-height: 76rpx;
  margin-top: 24rpx;
  padding: 14rpx 24rpx;
  box-sizing: border-box;
  background: var(--btn-bg);
  color: var(--btn-text);
}
.compact {
  width: auto;
  margin: 0;
  min-height: 60rpx;
  flex-shrink: 0;
  padding: 10rpx 20rpx;
}
.small {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 56rpx;
  padding: 8rpx 18rpx;
  background: var(--chip-bg);
  border: 1rpx solid var(--chip-border);
  color: var(--text);
  font-size: 22rpx;
  flex-shrink: 0;
}
.text-button {
  padding: 10rpx 0;
  min-height: 56rpx;
  color: var(--accent);
  background: transparent;
  font-size: 24rpx;
}
.centered {
  margin: 12rpx auto 0;
}
.wide {
  width: 100%;
  margin-top: 22rpx;
}
.toolbar,
.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.toolbar {
  margin-bottom: 8rpx;
}
.muted {
  color: var(--text-sub);
  font-size: 24rpx;
  line-height: 1.65;
}
.micro {
  color: var(--text-faint);
  font-size: 20rpx;
  line-height: 1.6;
}
.error-bar {
  padding: 20rpx 24rpx;
  margin: 24rpx 0;
  background: var(--error-bg);
  color: var(--error-text);
  font-size: 24rpx;
  line-height: 1.6;
  border-radius: 14rpx;
}
.table-head {
  display: flex;
  padding: 26rpx 0 18rpx;
  color: var(--text-faint);
  font-size: 22rpx;
  border-bottom: 1rpx solid var(--card-border);
}
.asset-name {
  flex: 1;
  min-width: 0;
}
.price-col {
  width: 180rpx;
  flex-shrink: 0;
  text-align: right;
}
.change-col {
  width: 162rpx;
  flex-shrink: 0;
  text-align: right;
}
.list-item {
  border-bottom: 1rpx solid var(--card-border);
}
.quote-row {
  display: flex;
  align-items: center;
  min-height: 132rpx;
  padding: 10rpx 0;
  box-sizing: border-box;
}
.name {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.45;
}
.code {
  font-size: 20rpx;
  color: var(--text-sub2);
  margin-top: 8rpx;
  line-height: 1.6;
  font-variant-numeric: tabular-nums;
}
.quote-value {
  font-size: 32rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.change-pill {
  display: inline-flex;
  min-width: 112rpx;
  box-sizing: border-box;
  justify-content: center;
  padding: 6rpx 8rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  font-variant-numeric: tabular-nums;
  background: var(--pill-flat);
}
.up {
  color: var(--up);
}
.down {
  color: var(--down);
}
.flat {
  color: var(--text-sub);
}
.change-pill.up {
  background: var(--pill-up);
}
.change-pill.down {
  background: var(--pill-down);
}
.bell-status {
  display: block;
  color: var(--accent);
  font-size: 18rpx;
}
.manage-hint {
  color: var(--text-sub);
  font-size: 22rpx;
  padding: 14rpx 0;
}
.manage-row {
  display: flex;
  align-items: center;
  height: 132rpx;
  gap: 20rpx;
}
.manage-row .name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.drag-handle {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  width: 76rpx;
  flex-shrink: 0;
  color: var(--text-sub2);
  font-size: 32rpx;
}
.managing .list-item {
  position: relative;
  background: var(--bg);
}
.managing .dragging {
  z-index: 2;
  background: var(--card);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}
.danger {
  color: var(--error-text);
}
.foot {
  margin-top: 26rpx;
  font-size: 20rpx;
  line-height: 1.8;
  color: var(--text-faint);
}
.empty {
  padding: 64rpx 24rpx;
  text-align: center;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.empty .primary {
  margin: 36rpx auto 0;
  width: auto;
  max-width: 400rpx;
}
.panel {
  padding: 26rpx 24rpx;
  margin-top: 24rpx;
  border: 1rpx solid var(--card-border);
  border-radius: 22rpx;
  background: var(--card);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.section-row .section-title {
  margin-bottom: 8rpx;
}
.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--card-border);
  font-size: 24rpx;
  line-height: 1.6;
}
.summary-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}
.search-box {
  display: flex;
  align-items: center;
  padding: 12rpx 22rpx;
  margin: 24rpx 0;
  gap: 18rpx;
  background: var(--card);
  border: 1rpx solid var(--chip-border);
  border-radius: 16rpx;
}
.search-input {
  min-width: 0;
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
}
.search-result {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--card-border);
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}
.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}
.type-button {
  background: var(--chip-bg);
  color: var(--text);
  padding: 18rpx 10rpx;
  border: 1rpx solid var(--chip-border);
  font-size: 25rpx;
}
.type-button.selected {
  border-color: var(--accent);
  color: var(--accent);
}
.picker-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  gap: 18rpx;
  border-bottom: 1rpx solid var(--card-border);
  font-size: 26rpx;
}
.picker-value {
  margin-left: auto;
  font-variant-numeric: tabular-nums;
}
.picker-arrow {
  margin-left: auto;
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.picker-chevron {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid var(--text-faint);
  border-bottom: 3rpx solid var(--text-faint);
  transform: translateY(-3rpx) rotate(45deg);
}
.picker-value + .picker-arrow {
  margin-left: 0;
}
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 96rpx;
  font-size: 26rpx;
}
.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--chip-border);
}
.input-row input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  font-size: 34rpx;
  font-variant-numeric: tabular-nums;
}
.rule-row {
  border-top: 1rpx solid var(--card-border);
  padding: 26rpx 0 6rpx;
  margin-top: 20rpx;
}
.rule-copy {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.7;
}
.rule-row .text-button {
  margin-left: auto;
  font-size: 22rpx;
}
.quota-panel {
  border-color: var(--card-main-border);
}
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22rpx 14rpx;
  margin-top: 30rpx;
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
}
.refresh-button {
  padding: 12rpx 20rpx;
  background: var(--chip-bg);
  color: var(--accent);
  font-size: 22rpx;
}
.chart-error {
  margin-bottom: 0;
}

/* ---------- 统一线性图标（CSS 绘制，不使用 Emoji / 字符符号） ---------- */
.icon-plus {
  position: relative;
  width: 20rpx;
  height: 20rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.icon-plus::before,
.icon-plus::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
}
.icon-plus::after {
  width: 3rpx;
  height: 20rpx;
}
.icon-plus.sm {
  width: 16rpx;
  height: 16rpx;
}
.icon-plus.sm::before {
  width: 16rpx;
  height: 2.5rpx;
}
.icon-plus.sm::after {
  width: 2.5rpx;
  height: 16rpx;
}
.icon-drag {
  position: relative;
  width: 32rpx;
  height: 7rpx;
}
.icon-drag::before,
.icon-drag::after {
  content: "";
  position: absolute;
  left: 0;
  width: 32rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
}
.icon-drag::before {
  top: 0;
}
.icon-drag::after {
  bottom: 0;
}
.chev {
  width: 12rpx;
  height: 12rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(-45deg) translateY(-2rpx);
}
.manage-link {
  display: flex;
  align-items: center;
}

/* Home-only styles: this file is also imported by other pages. */
.home-page {
  padding: 40rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}

.home-page .home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 36rpx;
}

.home-page .home-heading {
  flex: 1;
  min-width: 0;
}

.home-page .hero-title {
  font-size: 48rpx;
  line-height: 1.3;
  font-weight: 600;
  letter-spacing: normal;
}

.home-page .hero-sub {
  margin-top: 16rpx;
  color: var(--text-mid);
  font-size: 24rpx;
  line-height: 1.6;
}

.home-page .home-add,
.home-page .home-empty-add {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: auto;
  min-width: 0;
  min-height: 76rpx;
  margin: 0;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: var(--btn-bg);
  color: var(--btn-text);
  font-size: 26rpx;
  flex-shrink: 0;
}

.home-page .home-add {
  margin-top: 2rpx;
}

.home-page .watchlist-card {
  padding: 0 24rpx;
  background: var(--card);
  border: 1rpx solid var(--card-border);
  border-radius: 28rpx;
}

.home-page .watchlist-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 112rpx;
  border-bottom: 1rpx solid var(--card-border);
}

.home-page .watchlist-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.home-page .watchlist-count {
  color: var(--text-mid);
  background: var(--chip-bg);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
}

.home-page .home-manage {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: auto;
  min-width: 80rpx;
  min-height: 72rpx;
  margin: 0 -8rpx 0 0;
  padding: 12rpx 8rpx;
  background: transparent;
  color: var(--text-mid);
  font-size: 24rpx;
  flex-shrink: 0;
}

.home-page .home-manage.is-managing {
  min-height: 64rpx;
  margin-right: 0;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  color: var(--btn-text);
  background: var(--btn-bg);
  font-weight: 600;
}

.home-page .price-col {
  width: 176rpx;
}

.home-page .change-col {
  width: 146rpx;
}

.home-page .quote-row {
  min-height: 176rpx;
  padding: 26rpx 0;
}

.home-page .asset-name {
  padding-right: 12rpx;
}

.home-page .name {
  color: var(--text);
  font-size: 29rpx;
  line-height: 1.5;
  overflow-wrap: break-word;
}

.home-page .code {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-mid);
}

.home-page .reminder-tag {
  display: inline-block;
  margin-top: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  color: var(--text-mid);
  background: var(--ohlc-bg);
  font-size: 19rpx;
  line-height: 1.5;
}

.home-page .quote-value {
  color: var(--text);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.home-page .quote-status {
  margin-top: 8rpx;
  color: var(--text-mid);
  font-size: 20rpx;
  line-height: 1.5;
}

.home-page .change-pill {
  min-width: 128rpx;
  padding: 14rpx 8rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}

.home-page .list-item:last-child {
  border-bottom: 0;
}

.home-page .manage-row {
  height: 136rpx;
  gap: 12rpx;
  padding: 0 16rpx 0 4rpx;
}

.home-page .drag-handle {
  width: 64rpx;
  color: var(--text-mid);
}

.home-page .manage-hint {
  padding: 20rpx 0;
  color: var(--text-mid);
  line-height: 1.6;
}

.home-page .empty {
  padding: 56rpx 16rpx 64rpx;
}

.home-page .empty-title {
  font-size: 32rpx;
  line-height: 1.5;
}

.home-page .empty .muted {
  color: var(--text-mid);
}

.home-page .home-empty-add {
  margin: 32rpx auto 0;
  max-width: 360rpx;
}

.home-page .home-footer {
  padding: 28rpx 8rpx 0;
  color: var(--text-mid);
  font-size: 21rpx;
  line-height: 1.7;
}

.home-page .update-note {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
}

.home-page .update-dot {
  width: 8rpx;
  height: 8rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--text-mid);
}

.home-page .home-disclaimer + .home-disclaimer {
  margin-top: 4rpx;
}

.home-page .managing .list-item {
  margin-bottom: 16rpx;
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  background: var(--ohlc-bg);
}

.home-page .managing .dragging {
  background: var(--ohlc-bg);
}

.home-page .watchlist-card.is-editing {
  padding-bottom: 8rpx;
}

.home-page .managing .list-item:last-child {
  border-bottom: 1rpx solid var(--card-border);
}

.home-page .drag-handle .icon-drag {
  width: 18rpx;
  height: 28rpx;
}

.home-page .drag-handle .icon-drag::before,
.home-page .drag-handle .icon-drag::after {
  top: 0;
  bottom: auto;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  box-shadow: 0 11rpx 0 currentColor, 0 22rpx 0 currentColor;
}

.home-page .drag-handle .icon-drag::after {
  left: auto;
  right: 0;
}

.home-page .home-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  gap: 6rpx;
  width: auto;
  min-width: 112rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 12rpx;
  border-radius: 12rpx;
  background: var(--card);
  border: 1rpx solid var(--card-border);
  color: var(--status-bad);
  font-size: 23rpx;
}

.home-page .remove-icon {
  display: block;
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}
