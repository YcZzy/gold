<page-meta page-style="background-color: {{theme === 'blackgold' ? '#14120b' : '#f4f1ea'}};" background-color="{{theme === 'blackgold' ? '#14120b' : '#f4f1ea'}}" root-background-color="{{theme === 'blackgold' ? '#14120b' : '#f4f1ea'}}" />
<view class="page home-page tab-page theme-{{theme}} {{display.quiet ? 'quiet-mode' : ''}} {{display.compact ? 'compact-mode' : ''}}">
  <view class="home-header">
    <view class="home-heading">
      <view class="heading-eyebrow">WATCHLIST · 自选行情</view>
      <view class="hero-title">我的自选</view>
      <view class="hero-sub">让每一次关注，都有迹可循</view>
    </view>
    <button class="home-add glass-control" hover-class="glass-control-pressed" bindtap="openSearch" aria-label="搜索并添加自选">
      <view class="icon-plus" aria-hidden="true"></view><text>添加自选</text>
    </button>
  </view>

  <view class="workspace-shortcuts">
    <button data-target="market" bindtap="openWorkspace" hover-class="home-pressed"><view class="shortcut-icon shortcut-market" aria-hidden="true"><view></view><view></view><view></view></view><view class="shortcut-copy"><view class="shortcut-title">行情发现</view><view class="shortcut-caption">指数 · 热点 · 榜单</view></view><view class="shortcut-chevron" aria-hidden="true"></view></button>
    <button data-target="holdings" bindtap="openWorkspace" hover-class="home-pressed"><view class="shortcut-icon shortcut-holdings" aria-hidden="true"></view><view class="shortcut-copy"><view class="shortcut-title">我的持仓</view><view class="shortcut-caption">记录每一笔投资</view></view><view class="shortcut-chevron" aria-hidden="true"></view></button>
    <button data-target="data" bindtap="openWorkspace" hover-class="home-pressed"><view class="shortcut-icon shortcut-groups" aria-hidden="true"></view><view class="shortcut-copy"><view class="shortcut-title">分组与备份</view><view class="shortcut-caption">整理 · 导入 · 备份</view></view><view class="shortcut-chevron" aria-hidden="true"></view></button>
  </view>

  <scroll-view wx:if="{{!manage}}" class="group-scroll" scroll-x enhanced show-scrollbar="{{false}}" aria-label="自选分组">
    <view class="group-chips">
      <button class="{{!view.groupId ? 'selected' : ''}}" data-id="" bindtap="chooseGroup" hover-class="home-pressed" aria-pressed="{{!view.groupId}}">全部自选<text class="group-total">{{rows.length}}</text></button>
      <button wx:for="{{groups}}" wx:key="id" class="{{view.groupId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseGroup" hover-class="home-pressed" aria-pressed="{{view.groupId === item.id}}">{{item.name}}</button>
    </view>
  </scroll-view>

  <view class="watchlist-card {{manage ? 'is-editing' : ''}}">
    <view class="watchlist-heading">
      <view class="watchlist-title">{{manage ? '编辑自选' : groupName}}<text class="watchlist-count">{{manage ? rows.length : visibleRows.length}} 个</text></view>
      <button wx:if="{{rows.length}}" class="home-manage {{manage ? 'is-managing' : ''}}" bindtap="toggleManage" disabled="{{busy}}" hover-class="home-pressed">{{manage ? '完成' : '管理'}}</button>
    </view>

    <view wx:if="{{rows.length && !manage}}" class="workspace-toolbar">
      <picker range="{{sortOptions}}" value="{{sortIndex}}" bindchange="changeSort" disabled="{{busy}}" aria-label="自选排序，当前{{sortOptions[sortIndex]}}"><view class="sort-trigger"><view class="sort-icon" aria-hidden="true"></view><text>{{sortOptions[sortIndex]}}</text><view class="down-chevron" aria-hidden="true"></view></view></picker>
      <button class="filter-trigger {{filterOpen || filterCount ? 'is-active' : ''}}" bindtap="toggleFilters" hover-class="home-pressed" aria-expanded="{{filterOpen}}" aria-controls="watch-filter"><view class="filter-icon" aria-hidden="true"></view><text>筛选</text><text wx:if="{{filterCount}}" class="filter-count">{{filterCount}}</text><view class="down-chevron {{filterOpen ? 'is-open' : ''}}" aria-hidden="true"></view></button>
    </view>
    <view wx:if="{{filterOpen && !manage}}" id="watch-filter" class="watch-filter">
      <view class="filter-heading"><text>筛选自选</text><button class="filter-reset" bindtap="resetConditions" hover-class="home-pressed">重置条件</button></view>
      <view class="filter-pickers">
        <view><view class="filter-label">市场</view><picker range="{{markets}}" value="{{marketIndex}}" bindchange="setMarket" aria-label="选择市场"><view class="filter-select"><text>{{markets[marketIndex]}}</text><view class="down-chevron" aria-hidden="true"></view></view></picker></view>
        <view><view class="filter-label">类型</view><picker range="{{kinds}}" value="{{kindIndex}}" bindchange="setKind" aria-label="选择标的类型"><view class="filter-select"><text>{{kinds[kindIndex]}}</text><view class="down-chevron" aria-hidden="true"></view></view></picker></view>
      </view>
      <label class="filter-label" for="watch-query">关键词</label>
      <input id="watch-query" data-key="query" value="{{view.query}}" bindinput="setCondition" placeholder="搜索名称、代码、备注或标签" placeholder-class="filter-placeholder" confirm-type="done" aria-label="在自选中搜索名称代码备注标签" />
      <view class="filter-inputs">
        <view><label class="filter-label" for="min-price">最低价格</label><input id="min-price" type="digit" data-key="minPrice" value="{{view.minPrice}}" bindinput="setCondition" placeholder="不限" placeholder-class="filter-placeholder" aria-label="最低价格" aria-invalid="{{!!filterError}}" aria-describedby="filter-error" /></view>
        <view><label class="filter-label" for="max-price">最高价格</label><input id="max-price" type="digit" data-key="maxPrice" value="{{view.maxPrice}}" bindinput="setCondition" placeholder="不限" placeholder-class="filter-placeholder" aria-label="最高价格" aria-invalid="{{!!filterError}}" aria-describedby="filter-error" /></view>
        <view><label class="filter-label" for="min-pct">最低涨跌幅 %</label><input id="min-pct" data-key="minPct" value="{{view.minPct}}" bindinput="setCondition" placeholder="例如 -5" placeholder-class="filter-placeholder" aria-label="最低涨跌幅百分比，可输入负数" aria-invalid="{{!!filterError}}" aria-describedby="filter-error" /></view>
        <view><label class="filter-label" for="max-pct">最高涨跌幅 %</label><input id="max-pct" data-key="maxPct" value="{{view.maxPct}}" bindinput="setCondition" placeholder="例如 5" placeholder-class="filter-placeholder" aria-label="最高涨跌幅百分比，可输入负数" aria-invalid="{{!!filterError}}" aria-describedby="filter-error" /></view>
      </view>
      <view wx:if="{{filterError}}" id="filter-error" class="filter-error" role="alert">{{filterError}}</view>
      <view class="filter-help">条件即时生效。仅筛选已取得的自选行情，不同币种价格不换汇。</view>
      <button class="filter-done" bindtap="toggleFilters" hover-class="home-pressed">查看 {{visibleRows.length}} 个结果</button>
    </view>
    <view wx:if="{{filterCount && !filterOpen && !manage}}" class="active-filter-note"><text>已启用 {{filterCount}} 项筛选 · {{visibleRows.length}} 个结果</text><button bindtap="resetConditions" hover-class="home-pressed" aria-label="清空全部筛选条件">清空</button></view>
    <view wx:if="{{errorText}}" class="error-bar" role="alert">{{errorText}}</view>
    <view wx:if="{{loading && !rows.length}}" class="empty loading-state" role="status"><view class="loading-mark" aria-hidden="true"></view><view class="empty-title">正在加载自选</view><view class="muted">为你整理关注的行情</view></view>
    <view wx:elif="{{!rows.length}}" class="empty">
      <view class="empty-illustration" aria-hidden="true"><view class="empty-line"></view><view class="empty-line short"></view></view>
      <view class="empty-title">从第一个关注开始</view>
      <view class="muted">把股票、ETF 或黄金加入自选<br />行情与提醒，在这里一目了然</view>
      <button class="home-empty-add" hover-class="home-pressed" bindtap="openSearch"><view class="icon-plus" aria-hidden="true"></view>搜索并添加</button>
    </view>
    <view wx:if="{{manage && rows.length}}" class="manage-hint">拖动左侧手柄排序，松手自动保存。移除自选会一并删除该标的提醒；分组在「分组与备份」中设置。</view>
    <view wx:if="{{rows.length && !visibleRows.length && !manage}}" class="empty">
      <view class="empty-illustration" aria-hidden="true"><view class="empty-line"></view><view class="empty-line short"></view></view>
      <view class="empty-title">{{filterCount ? '没有符合条件的自选' : '这个分组还没有自选'}}</view>
      <view class="muted">{{filterCount ? '试着放宽条件，看看其他关注' : '到「分组与备份」添加分组成员'}}</view>
      <button wx:if="{{filterCount}}" class="empty-secondary" bindtap="resetConditions" hover-class="home-pressed">重置筛选</button>
      <button wx:else class="empty-secondary" data-id="" bindtap="chooseGroup" hover-class="home-pressed">查看全部自选</button>
    </view>
    <view wx:if="{{visibleRows.length && !manage}}" class="list-columns"><text>标的 / 代码</text><text>最新价</text><text>涨跌幅</text></view>
    <view class="list {{manage ? 'managing' : ''}}">
      <view wx:for="{{visibleRows}}" wx:key="id" class="list-item {{draggingId === item.id ? 'dragging' : ''}}" style="{{draggingId === item.id ? 'transform: translateY(' + dragOffset + 'px);' : ''}}">
        <view wx:if="{{manage}}" class="manage-row">
          <view class="drag-handle" data-id="{{item.id}}" bindtouchstart="startDrag" catchtouchmove="dragMove" bindtouchend="endDrag" bindtouchcancel="cancelDrag" aria-label="拖动排序{{item.name}}"><view class="icon-drag" aria-hidden="true"></view></view>
          <view class="asset-name"><view class="name">{{item.name}}</view><view class="code">{{item.code}} · {{item.marketText}} · {{item.kindText}}</view></view>
          <button class="home-remove" data-id="{{item.id}}" catchtap="remove" disabled="{{busy || draggingId}}" hover-class="home-pressed" aria-label="删除{{item.name}}及全部提醒"><image class="remove-icon" src="/assets/icons/delete.svg" mode="aspectFit" aria-hidden="true" /><text>移除</text></button>
        </view>
        <button wx:else class="quote-row" hover-class="home-row-pressed" bindtap="openDetail" data-id="{{item.id}}" aria-label="查看{{item.name}}行情，最新价{{item.priceText || '待获取'}}，涨跌幅{{item.pctText || '待获取'}}">
          <view class="asset-name"><view class="name">{{item.name}}</view><view class="code"><text class="market-badge">{{item.marketText}}</text><text>{{item.code}} · {{item.kindText}}</text></view><view wx:if="{{item.activeCount}}" class="reminder-tag"><view class="reminder-dot" aria-hidden="true"></view>{{item.activeCount}} 条提醒</view></view>
          <view class="price-col"><view class="quote-value">{{item.priceText || '--'}}</view><view class="quote-status">{{item.statusText || '待获取'}}</view></view>
          <view class="change-col"><text class="change-pill {{item.changePct > 0 ? 'up' : item.changePct < 0 ? 'down' : 'flat'}}">{{item.pctText || '--'}}</text><view wx:if="{{display.showChange}}" class="change-amount {{item.cls}}" aria-label="涨跌额 {{item.changeText}}">{{item.changeText || '--'}}</view></view>
          <view wx:if="{{display.showNotes && (item.note || item.tags.length)}}" class="watch-annotation"><text wx:if="{{item.note}}" class="watch-note">{{item.note}}</text><view wx:if="{{item.tags.length}}" class="watch-tags"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="watch-tag">{{tag}}</text></view></view>
          <view wx:if="{{display.showTime}}" class="quote-time">报价时间 {{item.timeText}}</view>
        </button>
      </view>
    </view>
    <view wx:if="{{rows.length}}" class="list-capacity"><text>已关注 {{rows.length}} / {{limits.watchlist}} 个标的</text><text>{{manage ? (busy ? '正在保存…' : '调整后自动保存') : '点击标的查看详情'}}</text></view>
  </view>
  <view class="home-footer"><view class="update-note"><view class="update-dot" aria-hidden="true"></view><text>每分钟自动刷新 · 下拉可手动更新</text></view><view class="home-disclaimer">行情可能延迟，请留意各标的报价时间。</view><view class="home-disclaimer disclaimer">公开行情仅供参考，不构成投资建议。</view></view>
</view>
