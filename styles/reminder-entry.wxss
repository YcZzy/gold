.page .reminder-entry { display: flex; align-items: center; gap: 18rpx; box-sizing: border-box; width: 100%; min-width: 0; min-height: 120rpx; margin: 20rpx 0 0; padding: 22rpx 24rpx; border: 1rpx solid var(--card-border); border-radius: 22rpx; color: var(--text); background: var(--card); text-align: left; white-space: normal; line-height: 1.5; }
.page .reminder-icon-wrap { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 64rpx; height: 64rpx; border-radius: 18rpx; background: var(--ohlc-bg); }
.page .notice-img { width: 32rpx; height: 32rpx; }
.page .reminder-copy { flex: 1; min-width: 0; }
.page .reminder-title { font-size: 26rpx; font-weight: 600; }
.page .notice-text { margin-top: 6rpx; color: var(--text-mid); font-size: 21rpx; line-height: 1.7; }
.page .reminder-chevron { flex-shrink: 0; width: 10rpx; height: 10rpx; margin-right: 4rpx; border-top: 2rpx solid var(--text-mid); border-right: 2rpx solid var(--text-mid); transform: rotate(45deg); }
.page button.reminder-entry[disabled] { background: var(--card); color: var(--text); }
.page button.reminder-entry::after { border: 0; }
